# PROBE — environment config.
# Secrets stay here (this project isn't in a shared/upstream repo). If this
# folder is later put under git, add .env to .gitignore before committing.

# Ports
PROBE_DETECTOR_PORT=8020
PROBE_CORRELATOR_PORT=8021
PROBE_REMEDIATOR_PORT=8022
PROBE_DASHBOARD_PORT=8023

# ---------------------------------------------------------------
# ../astronomy-shop-elastic — the running app PROBE observes.
# Reached over its published host ports, not a shared docker network.
# ---------------------------------------------------------------
# host.docker.internal resolves to the Windows host from inside a
# container (Docker Desktop). flagd-ui/frontend-proxy is on 8080
# (compose.yaml's explicit "${ENVOY_PORT}:${ENVOY_PORT}" mapping). Only the
# dashboard needs this now — Detector/Correlator/Remediator deliberately do
# NOT self-instrument OTel traces into astronomy-shop-elastic's Elastic
# project anymore (they used to; that was PROBE's own telemetry polluting
# the shop's telemetry and showing up as false anomalies — see run.py in
# each service, and queries.py's explicit `NOT service.name LIKE "probe-*"`
# filter as defense-in-depth on top of that).

# The self-grading harness (harness/run_eval.py) runs on the host directly,
# not in a container, so it talks to astronomy-shop-elastic over plain
# localhost — see PROBE_FLAGD_UI_URL/PROBE_DETECTOR_URL/PROBE_CORRELATOR_URL
# defaults in harness/run_eval.py. Override here only if you changed ports.
# PROBE_FLAGD_UI_URL=http://localhost:8080/feature
# PROBE_DETECTOR_URL=http://localhost:8020
# PROBE_CORRELATOR_URL=http://localhost:8021

# ---------------------------------------------------------------
# Elasticsearch — a SEPARATE, read+monitor-scoped API key.
# Do NOT reuse astronomy-shop-elastic's ELASTIC_OTLP_API_KEY — that one is
# ingest-only (confirmed via a 403 on _search/_cat).
# ---------------------------------------------------------------
ELASTIC_ES_URL=https://my-observability-project-b14780.es.asia-south1.gcp.elastic.cloud
ELASTIC_API_KEY_READ=enF3SWdhQUJHVmdYYVdaX2lkZTE6RU9odlVoVWNGdmcwZ3JVdldETndZQQ==
KIBANA_URL=https://my-observability-project-b14780.kb.asia-south1.gcp.elastic.cloud

# ---------------------------------------------------------------
# Correlator's LLM backend. "bedrock" is the real path for the actual
# hackathon submission — set it back once AWS is set up. "anthropic",
# "openai", and "gemini" are dev/testing stand-ins that only need an API
# key you already have, no AWS account (see
# correlator/src/correlator/llm_client.py).
# ---------------------------------------------------------------
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=AIzaSyC4uwSCU-5_8JwUbbWaFPM4jY4D2FUibjc
# gemini-1.5-flash is deprecated for this key/API version — confirmed via
# GET /v1beta/models. gemini-2.5-flash-lite is the cheapest currently
# available model that still supports generateContent/tool-calling.
GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------
# AWS Bedrock — Claude Haiku (cheapest tier, ~fractions of a cent per
# Correlator call — anomaly list + dependency graph in, structured JSON
# out, roughly 1-2K tokens). AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY still
# needed (Stage 0).
#
# BEDROCK_MODEL_ID below is a guess — verify it in the AWS console under
# Bedrock -> Model access for ap-south-1 before relying on it:
#   - If Claude 3.5 Haiku shows as available with a bare model ID in
#     ap-south-1, use that ID directly.
#   - Many Anthropic models on Bedrock are only invokable via a
#     cross-region "inference profile" rather than a bare model ID —
#     Bedrock groups ap-south-1 under the "apac" profile set for these,
#     which is what the apac. prefix below assumes. The Bedrock console's
#     model access page shows you the exact ID/profile it wants you to use.
#   - Request model access first if it shows as "Available to request"
#     rather than "Access granted" — this can take a few minutes.
# ---------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-haiku-20241022-v1:0

# ---------------------------------------------------------------
# Jina AI embeddings — not yet provisioned (Stage 0)
# ---------------------------------------------------------------
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# ---------------------------------------------------------------
# Jira — optional, Remediator's second ticket path (Kibana Case is primary)
# ---------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
